# ===== 服务 =====
PORT=3001
NODE_ENV=development
# 忘记密码邮件里的公开访问地址；HTTP 直连部署填 http://IP:3001
PUBLIC_BASE_URL=

# ===== CORS 白名单（生产/演示同源后可留空）=====
# 本地直接打开 index.html（file://）时需列出前端来源；
# 用 Express 托管静态文件后前后端同源，此项可置空。
CORS_ORIGIN=

# ===== 会话密钥（上线前必须改为强随机值；生产环境不能用 replace-me）=====
SESSION_SECRET=replace-me
# HTTP 直连部署（如 http://IP:3001）留空即可，服务会自动使用非 Secure Cookie；
# HTTPS/反代后建议显式设为 true；强制 HTTP 时也可显式设为 false。
SESSION_COOKIE_SECURE=auto

# ===== 公开注册 =====
# true 开启公开注册；新账号默认 viewer 只读权限。
# 公网暴露前必须 ALLOW_REGISTER=false；生产环境误配为 true 时，服务启动会输出安全警告并写审计。
ALLOW_REGISTER=false
# 公开注册新账号的默认角色：viewer=只读，operator=可执行指令/管理业务，admin=全权限。
# 业务系统演示或个人使用时如需“注册后就能用”，可设 operator；公网对外开放请谨慎。
DEFAULT_REGISTER_ROLE=viewer

# ===== 首个管理员 =====
# 若数据库还没有用户，必须设置以下两项自动创建 admin；否则空库无法登录。
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ===== OpenClaw Gateway（慢路径兜底，可选）=====
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# ===== 快路径：直连模型 provider（默认 deepseek 官方）=====
# 形如 "<provider>/<model>"：前缀= models.json 里的 provider 名，后缀= model id
OPENCLAW_DIRECT_MODEL=deepseek/deepseek-chat
OPENCLAW_DIRECT_TIMEOUT_MS=30000
# Gateway 兜底超时
OPENCLAW_GATEWAY_TIMEOUT_MS=60000

# provider 凭据（留空则自动从 ~/.openclaw/agents/main/agent/models.json 读）
OPENCLAW_PROVIDER_BASE_URL=
OPENCLAW_PROVIDER_API_KEY=

# ===== Feishu =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：调度器告警群 chat_id，留空则只写 audit_logs
FEISHU_ALERT_CHAT_ID=
# 可选：逗号分隔白名单，留空则接受所有聊天/用户
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_ALLOWED_SENDER_IDS=

# ===== 运维 =====
# 数据库每日备份分钟（0-1439），默认凌晨 3:00
DAILY_BACKUP_MINUTE=180

# ===== Agent 模式 =====
AGENT_MODE=auto
AGENT_MAX_ROUNDS=6

# 直连工具调用单次最大生成 token（成本相关）
OPENCLAW_DIRECT_MAX_TOKENS=4000

# ===== 执行器：Email（SMTP 发件）=====
# 个人推荐 QQ 邮箱：mail.qq.com → 设置 → 账号 → 开启 SMTP 服务 → 获取 16 位授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_TO=
# SMTP_FROM=可选，默认同 SMTP_USER

# ===== 执行器：Telegram（Bot API）=====
# @BotFather 创建 bot 拿 token；chat_id 可用 getUpdates 查询。注意：国内服务器访问 api.telegram.org 不通
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
