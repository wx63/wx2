{
  "name": "ecommerce-agent-server",
  "version": "0.1.0",
  "description": "OpenClaw AI跨境运营员工平台 - 后端桥接服务",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "start:prod": "pm2 start index.js --name ecommerce-agent --cwd . --log ../logs/out.log --error ../logs/err.log --merge-logs --time",
    "dev": "node --watch index.js",
    "test": "node --require ./test/setup-env.cjs --test --test-concurrency=1",
    "test:frontend": "node --test --test-concurrency=1 test/frontend.smoke.test.js test/frontend.buttons.test.js test/frontend.auth.test.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "pm2": "^7.0.3"
  }
}
