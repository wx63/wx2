# ===== 依赖 =====
server/node_modules/
**/node_modules/

# ===== 环境变量（含 token / api key，禁止提交）=====
.env
.env.*
!.env.example

# ===== 日志 / 运行时 =====
*.log
*.err.log
server.log
server.err.log
logs/

# ===== 临时 / 校验脚本 =====
.smoke.js
.smoke-check.js
.verify*.js
verify*.js
.diag*.js

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ===== OpenClaw 本地配置（敏感：含 token）=====
# 注意：openclaw.json 在 ~/.openclaw/ 下，本仓库不含；这里仅防误提交本地副本
openclaw.json
openclaw.json.bak*

# ===== 运行时数据（按需保留或忽略）=====
# 业务数据统一迁移到 SQLite，本地运行产出不入库
/data/*.db
/data/*.db-*
/data/approvals.json
server/data/*.db
server/data/*.db-*
